meta {
  name: Подсказки
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/api/works/suggest?q=нейр
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.works.length: gt 0
  res.body.works.length: lte 6
  res.body.people.length: lte 4
}

tests {
  test("совпавшие слова помечены, из кусков собирается название", function () {
    const w = res.body.works[0];
    expect(w.parts.map(p => p.text).join("")).to.equal(w.title);
    expect(w.parts.some(p => p.hit && /^нейр/i.test(p.text))).to.be.true;
  });
}
