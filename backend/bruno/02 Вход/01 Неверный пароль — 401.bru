meta {
  name: Неверный пароль — 401
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "{{moderatorLogin}}",
    "password": "неверный пароль"
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq invalid_credentials
}
