meta {
  name: Создать дубль
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/admin/people
  body: json
  auth: none
}

body:json {
  {
    "fullName": "Брунов Т. Т.",
    "kind": "external"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("personB", res.body.id);
}
