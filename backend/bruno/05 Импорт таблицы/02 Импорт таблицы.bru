meta {
  name: Импорт таблицы
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/imports
  body: multipartForm
  auth: none
}

body:multipart-form {
  kind: table
  workType: publication
  file: @file(files/publications.csv)
}

assert {
  res.status: eq 201
  res.body.status: eq done
  res.body.stats.filled: eq 1
  res.body.stats.errors: eq 1
  res.body.stats.unmatched: eq 1
}

script:post-response {
  bru.setVar("tableImportId", res.body.id);
}
