meta {
  name: Работы с файлами zip
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/admin/exports/works.zip?importId={{tableImportId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("content-type: application/zip", function () {
    expect(res.headers["content-type"]).to.include("application/zip");
  });
  test("content-disposition: .zip", function () {
    expect(res.headers["content-disposition"]).to.include(".zip");
  });
}
