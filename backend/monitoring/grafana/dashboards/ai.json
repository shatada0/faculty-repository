{
  "uid": "ai",
  "title": "ИИ",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Доля исправленных модератором по полю",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT field, sum(corrected)::float / sum(total) AS corrected FROM stats.ai_accuracy GROUP BY field ORDER BY 2 DESC",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Доля исправленных по confidence (порог 0.7)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT confidence_from::text AS confidence, sum(corrected)::float / sum(total) AS corrected FROM stats.ai_accuracy GROUP BY 1 ORDER BY 1",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Время ответа модели",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.5, {service=\"extraction_worker\"} | json | __error__=\"\" | message=\"LLM ответил\" | unwrap duration_ms [1h]) by (service)",
          "queryType": "range",
          "legendFormat": "медиана"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service=\"extraction_worker\"} | json | __error__=\"\" | message=\"LLM ответил\" | unwrap duration_ms [1h]) by (service)",
          "queryType": "range",
          "legendFormat": "95-й процентиль"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Ответы модели по исходу",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (message) (count_over_time({service=\"extraction_worker\"} | json | __error__=\"\" | message=~\"LLM ответил|LLM: таймаут|LLM-сервер недоступен|LLM: цепь разомкнута|LLM ответил ошибкой|LLM отклонил запрос|Ответ модели не разобран\" [1h]))",
          "queryType": "range",
          "legendFormat": "{{message}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}