# Только несекретное: версии, домен, модель. Секреты — файлы в secrets/ (scripts/dev-secrets.sh).
SITE_DOMAIN=localhost
# локально запрос с хоста приходит в nginx с адреса шлюза Docker, а не 127.0.0.1; на сервере — сеть вуза
STATS_ALLOW=172.16.0.0/12
FACULTY_NAME=

# образы: локально docker compose up --build собирает, на сервере docker compose pull берёт из реестра
REGISTRY=local
IMAGE_TAG=dev
BASE_IMAGE=project-base
MINIO_REF=RELEASE.2025-10-15T17-29-55Z
MC_REF=RELEASE.2025-08-13T08-35-41Z
VLLM_VERSION=v0.31.0
GRAFANA_VERSION=13.2.3
LOKI_VERSION=3.7.8
ALLOY_VERSION=v1.20.1
PROMETHEUS_VERSION=v3.15.0
PG_EXPORTER_VERSION=v0.20.1

# сервисы
AUTH_COOKIE_NAME=__Host-session
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=["https://localhost","http://localhost:5173"]
S3_PUBLIC_URL=https://files.localhost
AMQP_USER=app
CROSSREF_MAILTO=

# LLM: в compose — профиль gpu (vLLM). Без GPU — Ollama или llama.cpp на хосте: LLM_URL=http://host.docker.internal:11434
LLM_URL=http://llm:8000
# Ollama: qwen3.5:4b — лучший результат бенчмарка (bench/REPORT.md); для vLLM — имя репозитория на Hugging Face
LLM_MODEL=ai-sage/GigaChat3.1-10B-A1.8B
LLM_REVISION=main
LLM_TIMEOUT_SECONDS=110
LLM_CONCURRENCY=4
